{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "matchDepNames": ["org.springframework:spring-webmvc"],
      "enabled": false
    },
    {
      "matchManagers": ["gradle"],
      "matchDepNames": ["org.springframework:spring-framework-bom"],
      "allowedVersions": "/^7\\.0\\.\\d+$/"
    }
  ]
}
